{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quansio.dev/schemas/json/local-files-config.schema.json",
  "title": "Quansio local files (config/local-files.yaml)",
  "description": "The desktop's local-file limits (DOMAIN.md 13.7): grant lifetime and caps, granted roots, media tokens, edit limits and the shared file watcher. Every number is bounded; no key accepts a path.",
  "x-quansio-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "local_files.enabled",
    "local_files.grant_ttl_ms",
    "local_files.grant_max_live",
    "local_files.grant_max_files",
    "local_files.grant_max_file_bytes",
    "local_files.grant_max_total_bytes",
    "local_files.roots_max",
    "local_files.entries_max",
    "local_files.media_max_tokens",
    "local_files.edit_max_bytes",
    "local_files.edit_max_sessions",
    "local_files.self_write_ttl_ms",
    "local_files.watch_debounce_ms",
    "local_files.watch_max_dirs",
    "local_files.watch_max_subscribers",
    "local_files.watch_queue_max",
    "local_files.watch_max_entries"
  ],
  "properties": {
    "version": { "const": 1 },
    "local_files.enabled": { "type": "boolean" },
    "local_files.grant_ttl_ms": { "type": "integer", "minimum": 5000, "maximum": 600000 },
    "local_files.grant_max_live": { "type": "integer", "minimum": 1, "maximum": 128 },
    "local_files.grant_max_files": { "type": "integer", "minimum": 1, "maximum": 100 },
    "local_files.grant_max_file_bytes": { "type": "integer", "minimum": 1024, "maximum": 268435456 },
    "local_files.grant_max_total_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824 },
    "local_files.roots_max": { "type": "integer", "minimum": 1, "maximum": 32 },
    "local_files.entries_max": { "type": "integer", "minimum": 64, "maximum": 65536 },
    "local_files.media_max_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "local_files.edit_max_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
    "local_files.edit_max_sessions": { "type": "integer", "minimum": 1, "maximum": 64 },
    "local_files.self_write_ttl_ms": { "type": "integer", "minimum": 100, "maximum": 10000 },
    "local_files.watch_debounce_ms": { "type": "integer", "minimum": 50, "maximum": 5000 },
    "local_files.watch_max_dirs": { "type": "integer", "minimum": 1, "maximum": 256 },
    "local_files.watch_max_subscribers": { "type": "integer", "minimum": 1, "maximum": 64 },
    "local_files.watch_queue_max": { "type": "integer", "minimum": 16, "maximum": 4096 },
    "local_files.watch_max_entries": { "type": "integer", "minimum": 100, "maximum": 100000 }
  }
}
