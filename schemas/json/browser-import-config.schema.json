{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quansio.dev/schemas/json/browser-import-config.schema.json",
  "title": "Quansio staged browser-data imports (config/browser-import.yaml)",
  "description": "Bounds for the cookie bundles a person stages for an approved browser.import_session call (DOMAIN.md 13.9 B): how long one waits, how many cookies it carries, how large a value and a bundle may be. A staged bundle is never kept past its time.",
  "x-quansio-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "ttl_seconds", "max_cookies", "max_value_bytes", "max_bundle_bytes", "max_domains_listed"],
  "properties": {
    "version": { "const": 1 },
    "enabled": { "type": "boolean" },
    "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
    "max_cookies": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "max_value_bytes": { "type": "integer", "minimum": 64, "maximum": 8192 },
    "max_bundle_bytes": { "type": "integer", "minimum": 4096, "maximum": 33554432 },
    "max_domains_listed": { "type": "integer", "minimum": 1, "maximum": 200 }
  }
}
