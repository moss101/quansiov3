{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quansio.dev/schemas/json/local-secrets-config.schema.json",
  "title": "Quansio local secrets (config/local-secrets.yaml)",
  "description": "The desktop's human-only secrets surface (DOMAIN.md 13.9): the password manager, browser data import and one-time payment inputs. Every number is bounded; no key names a path or holds a secret.",
  "x-quansio-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "local_secrets.enabled",
    "local_secrets.passwords_max",
    "local_secrets.field_max_chars",
    "local_secrets.suggestions_max",
    "local_secrets.confirm_ttl_ms",
    "local_secrets.fill_max_age_ms",
    "local_secrets.import_enabled",
    "local_secrets.import_max_cookies",
    "local_secrets.import_max_logins",
    "local_secrets.import_max_db_bytes",
    "local_secrets.import_approval_ttl_ms",
    "local_secrets.payment_ttl_ms",
    "local_secrets.payment_max_fields",
    "local_secrets.payment_value_max_chars"
  ],
  "properties": {
    "version": { "const": 1 },
    "local_secrets.enabled": { "type": "boolean" },
    "local_secrets.passwords_max": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "local_secrets.field_max_chars": { "type": "integer", "minimum": 16, "maximum": 4096 },
    "local_secrets.suggestions_max": { "type": "integer", "minimum": 1, "maximum": 32 },
    "local_secrets.confirm_ttl_ms": { "type": "integer", "minimum": 5000, "maximum": 300000 },
    "local_secrets.fill_max_age_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 },
    "local_secrets.import_enabled": { "type": "boolean" },
    "local_secrets.import_max_cookies": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "local_secrets.import_max_logins": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "local_secrets.import_max_db_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
    "local_secrets.import_approval_ttl_ms": { "type": "integer", "minimum": 10000, "maximum": 900000 },
    "local_secrets.payment_ttl_ms": { "type": "integer", "minimum": 10000, "maximum": 900000 },
    "local_secrets.payment_max_fields": { "type": "integer", "minimum": 1, "maximum": 16 },
    "local_secrets.payment_value_max_chars": { "type": "integer", "minimum": 4, "maximum": 256 }
  }
}
